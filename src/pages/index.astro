---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar.astro";
import EmoteGrid from "../components/EmoteGrid.astro";
import manifest from "../data/manifest.json";

const siteTitle = "EmoteLab — Anime Emote Browser";
const siteDescription = "Browse, search, and share anime character emotes (GIFs)";

// Derive unique characters from the manifest (in order of first appearance)
const seen = new Set<string>();
const characters = manifest
  .map((e) => e.character)
  .filter((c) => (seen.has(c) ? false : (seen.add(c), true)));
---

<Layout title={siteTitle} description={siteDescription} emotes={manifest}>
  <header class="app-header">
    <h1>🎬 EmoteLab</h1>
    <span class="count">{manifest.length} emotes</span>
  </header>

  <SearchBar characters={characters} />
  <EmoteGrid character={characters[0]} emotes={manifest} />

  <footer class="app-footer">
    <p>Tap any emote to share it • <kbd>Ctrl+K</kbd> to search</p>
  </footer>
</Layout>

<style>
  .app-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    padding: 1rem 1rem 0;
  }

  .app-header h1 {
    font-size: 1.3rem;
    font-weight: 700;
  }

  .count {
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .app-footer {
    text-align: center;
    padding: 2rem 1rem;
    font-size: 0.75rem;
    color: var(--color-text-muted);
  }

  .app-footer kbd {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.3rem;
    padding: 0.1rem 0.4rem;
    font-size: 0.7rem;
    font-family: inherit;
  }
</style>
