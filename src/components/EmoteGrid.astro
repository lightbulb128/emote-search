---
import type { EmoteEntry } from "../lib/types";

interface Props {
  character: string;
  emotes: EmoteEntry[];
}

const { character, emotes } = Astro.props;
const BASE = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
// R2 base URL for production builds; `PUBLIC_` prefix makes it available client-side too
const R2_BASE = import.meta.env.PUBLIC_EMOTE_BASE_URL || "";

function resolveUrl(url: string): string {
  if (R2_BASE) return R2_BASE + url.replace(/^\/emotes/, "");
  if (url.startsWith("http")) return url;
  return `${BASE}${url.replace(/^\//, "")}`;
}
---

<div id="emote-grid" class="grid">
  {emotes.map((emote) => (
    <div class="card" data-id={emote.id} data-tags={emote.tags.join(" ")} data-character={emote.character}>
      <div class="card-image">
        <img
          src={resolveUrl(emote.url)}
          alt={emote.name}
          loading="lazy"
          width="300"
          height="300"
        />
      </div>
      <div class="card-info">
        <span class="card-name">{emote.name}</span>
        <span class="card-character">{emote.character}</span>
      </div>
    </div>
  ))}
</div>
<div id="compact-list" class="compact-list hidden"></div>

<style>
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.75rem;
    padding: 0.5rem;
  }

  .card {
    background: var(--color-surface);
    border-radius: 0.75rem;
    overflow: hidden;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
    cursor: pointer;
    border: 1px solid var(--color-border);
  }

  .card:hover,
  .card:active {
    transform: scale(1.03);
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.3);
  }

  .card-image {
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--color-bg);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .card-info {
    padding: 0.5rem 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }

  .card-name {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    line-height: 1.2;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-character {
    font-size: 0.68rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
  }

  .card.hidden {
    display: none;
  }

  .card.compact-hidden {
    display: none;
  }

  /* Compact text-only list for overflow results */
  .compact-list {
    padding: 0 0.5rem 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .compact-list.hidden {
    display: none;
  }

  .compact-list-header {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    padding: 0.5rem 0.7rem 0.3rem;
    border-top: 1px solid var(--color-border);
    margin-top: 0.3rem;
  }

  .compact-row {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.7rem;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: background 0.12s;
    font-size: 0.82rem;
    color: var(--color-text);
  }

  .compact-row:hover,
  .compact-row:active {
    background: var(--color-surface);
  }

  .compact-row-char {
    font-size: 0.65rem;
    color: var(--color-text-muted);
    text-transform: capitalize;
    background: var(--color-border);
    padding: 0.12rem 0.4rem;
    border-radius: 0.25rem;
    flex-shrink: 0;
  }

  .compact-row-name {
    flex: 1;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .compact-row-share {
    font-size: 0.7rem;
    color: var(--color-accent);
    flex-shrink: 0;
  }

  @media (max-width: 400px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
      gap: 0.5rem;
    }
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
      gap: 1rem;
    }
  }

  /* Share dialog — centered overlay */
  :global(.share-dialog) {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.2s;
  }

  :global(.share-dialog.open) {
    pointer-events: auto;
    opacity: 1;
  }

  :global(.share-backdrop) {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.55);
    backdrop-filter: blur(3px);
    -webkit-backdrop-filter: blur(3px);
  }

  :global(.share-panel) {
    position: relative;
    width: calc(100% - 2rem);
    max-width: 360px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 1.25rem;
    padding: 1.5rem 1.25rem;
    box-shadow: 0 8px 40px rgba(0, 0, 0, 0.5);
    transform: scale(0.92);
    transition: transform 0.2s ease;
  }

  :global(.share-dialog.open .share-panel) {
    transform: scale(1);
  }

  :global(.share-panel-header) {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1rem;
  }

  :global(.share-panel-title) {
    font-size: 1.05rem;
    font-weight: 700;
    color: var(--color-text);
  }

  :global(.share-panel-close) {
    background: none;
    border: none;
    color: var(--color-text-muted);
    font-size: 1.5rem;
    cursor: pointer;
    line-height: 1;
    padding: 0 0.25rem;
    border-radius: 0.5rem;
    transition: color 0.15s, background 0.15s;
  }

  :global(.share-panel-close:hover) {
    color: var(--color-text);
    background: var(--color-bg);
  }

  :global(.share-panel-body) {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  :global(.share-btn) {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.85rem 1rem;
    border: 1px solid var(--color-border);
    border-radius: 0.75rem;
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 0.95rem;
    cursor: pointer;
    transition: all 0.15s;
    width: 100%;
  }

  :global(.share-btn:hover),
  :global(.share-btn:active) {
    background: var(--color-border);
    border-color: var(--color-accent);
  }

  :global(.share-btn-icon) {
    font-size: 1.3rem;
    flex-shrink: 0;
  }

  :global(.share-btn-label) {
    font-weight: 500;
  }
</style>

<script>
  import { search, createSearchIndex, getAllEmotes } from "../lib/search";
  import type { EmoteEntry } from "../lib/types";

  const MAX_VISIBLE_CARDS = 9;
  const STORAGE_KEY = "emotelab-char";
  const COMPACT_KEY = "emotelab-compact";

  // Initialize Fuse.js with all emotes
  const emotesData: EmoteEntry[] = JSON.parse(
    document.getElementById("emote-data")?.textContent || "[]"
  );
  createSearchIndex(emotesData);

  // --- Compact toggle ---
  let compactMode = localStorage.getItem(COMPACT_KEY) !== "false"; // default ON

  const compactToggle = document.getElementById("compact-toggle") as HTMLButtonElement | null;
  function updateCompactButton() {
    if (!compactToggle) return;
    compactToggle.classList.toggle("on", compactMode);
    const icon = compactToggle.querySelector(".toggle-icon");
    const label = compactToggle.querySelector(".toggle-label");
    if (icon) icon.textContent = compactMode ? "📦" : "🖼️";
    if (label) label.textContent = compactMode ? "Compact" : "Full";
  }
  updateCompactButton();

  compactToggle?.addEventListener("click", () => {
    compactMode = !compactMode;
    localStorage.setItem(COMPACT_KEY, String(compactMode));
    updateCompactButton();
    updateDisplay();
  });

  // --- Character persistence ---
  const searchInput = document.getElementById("search-input") as HTMLInputElement | null;
  const grid = document.getElementById("emote-grid") as HTMLElement | null;
  const compactList = document.getElementById("compact-list") as HTMLElement | null;
  const charButtons = document.querySelectorAll<HTMLButtonElement>(".char-btn");

  // Read saved character or default to "alice"
  let activeCharacter = localStorage.getItem(STORAGE_KEY) || "alice";

  // Activate the correct button
  charButtons.forEach((btn) => {
    if (btn.dataset.char === activeCharacter) {
      btn.classList.add("active");
    }
  });

  let activeQuery = "";

  // --- Share helper ---
  function buildUrl(emote: EmoteEntry): string {
    const r2Base = (import.meta.env.PUBLIC_EMOTE_BASE_URL as string) || "";
    if (r2Base) return r2Base + emote.url.replace(/^\/emotes/, "");
    const base = (import.meta.env.BASE_URL || "/").replace(/\/?$/, "/");
    return location.origin + base + emote.url.replace(/^\//, "");
  }

  /** Fetch a GIF and return it as a File for sharing. */
  async function fetchGifAsFile(url: string, name: string): Promise<File | null> {
    try {
      const resp = await fetch(url);
      if (!resp.ok) return null;
      const blob = await resp.blob();
      const filename = name.replace(/[^a-zA-Z0-9_\- ]/g, "") + ".gif";
      return new File([blob], filename, { type: "image/gif" });
    } catch {
      return null;
    }
  }

  // --- Share dialog ---
  let currentShareEmote: EmoteEntry | null = null;

  const shareDialog = document.createElement("div");
  shareDialog.className = "share-dialog";
  shareDialog.innerHTML = `
    <div class="share-backdrop"></div>
    <div class="share-panel" role="dialog" aria-modal="true" aria-label="Share emote">
      <div class="share-panel-header">
        <span class="share-panel-title">Share Emote</span>
        <button class="share-panel-close" aria-label="Close">&times;</button>
      </div>
      <div class="share-panel-body">
        <button class="share-btn" data-action="copy">
          <span class="share-btn-icon">📋</span>
          <span class="share-btn-label">Copy Link</span>
        </button>
        <button class="share-btn" data-action="qq">
          <span class="share-btn-icon">🐧</span>
          <span class="share-btn-label">Share to QQ</span>
        </button>
        <button class="share-btn" data-action="native-share" style="display:none">
          <span class="share-btn-icon">📤</span>
          <span class="share-btn-label">Share…</span>
        </button>
        <button class="share-btn" data-action="gif-share" style="display:none">
          <span class="share-btn-icon">🎞️</span>
          <span class="share-btn-label">Share as GIF</span>
        </button>
      </div>
    </div>
  `;
  document.body.appendChild(shareDialog);

  // Toggle native share button visibility
  const nativeShareBtn = shareDialog.querySelector('[data-action="native-share"]') as HTMLButtonElement | null;
  const gifShareBtn = shareDialog.querySelector('[data-action="gif-share"]') as HTMLButtonElement | null;
  if (nativeShareBtn && navigator.share) {
    nativeShareBtn.style.display = "";
  }
  if (gifShareBtn && navigator.canShare && navigator.canShare({ files: [] })) {
    gifShareBtn.style.display = "";
  }

  function openShareDialog(emote: EmoteEntry) {
    currentShareEmote = emote;
    shareDialog.classList.add("open");
    document.body.style.overflow = "hidden";
  }

  function closeShareDialog() {
    shareDialog.classList.remove("open");
    currentShareEmote = null;
    document.body.style.overflow = "";
  }

  shareDialog.querySelector(".share-backdrop")?.addEventListener("click", closeShareDialog);
  shareDialog.querySelector(".share-panel-close")?.addEventListener("click", closeShareDialog);
  shareDialog.addEventListener("click", (e) => {
    const target = e.target as HTMLElement;
    if (!target.closest(".share-panel")) {
      closeShareDialog();
    }
  });

  shareDialog.addEventListener("click", async (e) => {
    const btn = (e.target as HTMLElement).closest("[data-action]") as HTMLElement | null;
    if (!btn || !currentShareEmote) return;

    const action = btn.dataset.action;
    const emote = currentShareEmote;
    const url = buildUrl(emote);
    const name = emote.name;

    closeShareDialog();

    switch (action) {
      case "copy":
        copyToClipboard(url, name);
        break;
      case "qq":
        shareToQQ(url, name);
        break;
      case "native-share":
        try {
          await navigator.share({ title: name, text: `${name} - EmoteLab`, url });
        } catch { /* cancelled */ }
        break;
      case "gif-share":
        showToast("⏳ Preparing GIF...");
        const file = await fetchGifAsFile(url, name);
        if (file) {
          try {
            await navigator.share({ files: [file], title: name });
          } catch { /* cancelled or failed */ }
        } else {
          copyToClipboard(url, name);
        }
        break;
    }
  });

  // ESC key to close
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && shareDialog.classList.contains("open")) {
      closeShareDialog();
    }
  });

  function buildQqWebShareUrl(url: string, title: string): string {
    const shareUrl = new URL("https://connect.qq.com/widget/shareqq/index.html");
    shareUrl.searchParams.set("url", url);
    shareUrl.searchParams.set("title", title);
    shareUrl.searchParams.set("desc", `${title} - EmoteLab`);
    shareUrl.searchParams.set("summary", "Check out this anime emote!");
    shareUrl.searchParams.set("pics", url);
    shareUrl.searchParams.set("site", "EmoteLab");
    return shareUrl.toString();
  }

  function openQqWebFallback(shareUrl: string) {
    const width = 700;
    const height = 520;
    const left = (screen.width - width) / 2;
    const top = (screen.height - height) / 2;
    const features = `width=${width},height=${height},left=${left},top=${top},toolbar=no,menubar=no,scrollbars=yes`;

    const popup = window.open(shareUrl, "share-qq", features);
    if (!popup) {
      window.location.href = shareUrl;
    }
  }

  /**
   * Try opening QQ app directly (receiver picker), then fall back to QQ web share page.
   * Note: browsers may block deep links on some platforms.
   */
  function shareToQQ(url: string, title: string) {
    const webShareUrl = buildQqWebShareUrl(url, title);
    const description = `${title} - EmoteLab`;
    const params = new URLSearchParams({
      src_type: "web",
      version: "1",
      file_type: "img",
      title,
      description,
      url: "www.baidu.com",
      thirdAppDisplayName: "EmoteLab",
    });

    const mobileScheme = `mqqapi://share/to_fri?${params.toString()}`;
    console.log(mobileScheme)
    const desktopScheme = `tencent.mobileqq://share/to_fri?${params.toString()}`;

    let appOpened = false;
    const onVisibility = () => {
      if (document.hidden) appOpened = true;
    };
    document.addEventListener("visibilitychange", onVisibility, { once: true });

    // Attempt deep link first in user-gesture context.
    const isMobile = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent);
    if (isMobile) {
      window.location.href = mobileScheme;
    } else {
      const iframe = document.createElement("iframe");
      iframe.style.display = "none";
      iframe.src = desktopScheme;
      document.body.appendChild(iframe);
      setTimeout(() => iframe.remove(), 800);
    }

    // If app did not open, fall back to the web share page.
    setTimeout(() => {
      if (!appOpened) {
        openQqWebFallback(webShareUrl);
      }
    }, 1200);
  }

  async function copyToClipboard(url: string, name: string) {
    try {
      await navigator.clipboard.writeText(url);
      showToast(`📋 Copied link for "${name}"`);
    } catch {
      const input = document.createElement("input");
      input.value = url;
      document.body.appendChild(input);
      input.select();
      document.execCommand("copy");
      document.body.removeChild(input);
      showToast(`📋 Copied link for "${name}"`);
    }
  }

  function showToast(message: string) {
    const existing = document.querySelector(".toast");
    if (existing) existing.remove();
    const toast = document.createElement("div");
    toast.className = "toast";
    toast.textContent = message;
    document.body.appendChild(toast);
    setTimeout(() => toast.classList.add("show"), 10);
    setTimeout(() => {
      toast.classList.remove("show");
      setTimeout(() => toast.remove(), 300);
    }, 2000);
  }

  // --- Render compact overflow list ---
  function renderCompactList(overflowEmotes: EmoteEntry[]) {
    if (!compactList) return;
    compactList.innerHTML = "";

    if (overflowEmotes.length === 0) {
      compactList.classList.add("hidden");
      return;
    }

    compactList.classList.remove("hidden");

    const header = document.createElement("div");
    header.className = "compact-list-header";
    header.textContent = `+ ${overflowEmotes.length} more result${overflowEmotes.length > 1 ? "s" : ""}`;
    compactList.appendChild(header);

    overflowEmotes.forEach((emote) => {
      const row = document.createElement("div");
      row.className = "compact-row";
      row.innerHTML = `
        <span class="compact-row-char">${emote.character}</span>
        <span class="compact-row-name">${emote.name}</span>
        <span class="compact-row-share">↗</span>
      `;
      row.addEventListener("click", (e) => {
        e.stopPropagation();
        openShareDialog(emote);
      });
      compactList.appendChild(row);
    });
  }

  // --- Update display ---
  function updateDisplay() {
    if (!grid) return;
    const cards = grid.querySelectorAll<HTMLElement>(".card");

    // Build a lookup: id → DOM card element
    const cardById = new Map<string, HTMLElement>();
    cards.forEach((card) => {
      cardById.set(card.dataset.id || "", card);
    });

    // Determine matching results (already in Fuse score order when searching)
    let results: EmoteEntry[] = [];
    if (activeQuery) {
      results = search(activeQuery);
    } else {
      // No query: show all for the active character, alphabetical
      results = getAllEmotes();
    }

    // Always filter by the selected character
    results = results.filter((e) => e.character === activeCharacter);

    const allResultIds = new Set(results.map((r) => r.id));

    // Show/hide cards and reorder by search ranking
    cards.forEach((card) => {
      const id = card.dataset.id || "";
      const shouldShow = allResultIds.has(id);
      card.classList.toggle("hidden", !shouldShow);
      card.classList.remove("compact-hidden");
      card.style.order = ""; // reset
    });

    // Assign CSS order to visible cards so they appear in search-result order
    results.forEach((emote, i) => {
      const card = cardById.get(emote.id);
      if (card) {
        card.style.order = String(i);
      }
    });

    // Only use compact overflow when enabled AND actively searching (> 3 results)
    if (compactMode && activeQuery && results.length > MAX_VISIBLE_CARDS) {
      // Hide cards beyond the top MAX_VISIBLE_CARDS
      for (let i = MAX_VISIBLE_CARDS; i < results.length; i++) {
        const card = cardById.get(results[i].id);
        if (card) {
          card.classList.add("compact-hidden");
        }
      }
      renderCompactList(results.slice(MAX_VISIBLE_CARDS));
    } else {
      renderCompactList([]);
    }
  }

  // --- Event listeners ---
  searchInput?.addEventListener("input", () => {
    activeQuery = searchInput.value;
    updateDisplay();
  });

  charButtons.forEach((btn) => {
    btn.addEventListener("click", () => {
      charButtons.forEach((b) => b.classList.remove("active"));
      btn.classList.add("active");
      activeCharacter = btn.dataset.char || "alice";
      localStorage.setItem(STORAGE_KEY, activeCharacter);
      updateDisplay();
    });
  });

  // --- Share on card click ---
  // Build a lookup from id → EmoteEntry for quick access
  const emoteById = new Map(emotesData.map((e) => [e.id, e]));

  grid?.addEventListener("click", (e) => {
    const card = (e.target as HTMLElement).closest(".card") as HTMLElement | null;
    if (!card || card.classList.contains("hidden") || card.classList.contains("compact-hidden")) return;

    const id = card.dataset.id || "";
    const emote = emoteById.get(id);
    if (!emote) return;
    openShareDialog(emote);
  });

  // --- Keyboard shortcut: Ctrl+K / Cmd+K to focus search ---
  document.addEventListener("keydown", (e) => {
    if ((e.ctrlKey || e.metaKey) && e.key === "k") {
      e.preventDefault();
      searchInput?.focus();
    }
  });

  // --- Initial display ---
  updateDisplay();
</script>
