{
  "name": "EmoteLab - Anime Emote Browser",
  "short_name": "EmoteLab",
  "description": "Browse, search, and share anime character emotes (GIFs)",
  "start_url": "/emote-search/",
  "scope": "/emote-search/",
  "display": "standalone",
  "orientation": "portrait-primary",
  "background_color": "#0f0f1a",
  "theme_color": "#7c5cfc",
  "icons": [
    {
      "src": "/emote-search/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/emote-search/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/emote-search/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "share_target": {
    "action": "/emote-search/",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "name",
      "text": "text"
    }
  },
  "categories": ["entertainment", "utilities"],
  "lang": "en"
