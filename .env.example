# Cloudflare R2 credentials (for uploading emotes to R2)
# Copy this file to .env and fill in your values.

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=emotes
R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxx.r2.dev

# R2 public URL for production build (used in GitHub Actions secrets)
# Also set as PUBLIC_EMOTE_BASE_URL in GitHub repo → Settings → Secrets
PUBLIC_EMOTE_BASE_URL=https://pub-xxxxxxxxxxxxxxxxxxxxx.r2.dev
